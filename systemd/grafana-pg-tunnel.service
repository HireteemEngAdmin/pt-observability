[Unit]
# The database is RDS in a private subnet, so it has no route from the internet
# and a security group rule alone cannot reach it. Rather than make a production
# database publicly accessible, Grafana reaches it through this tunnel: the
# observability host already has a route to the application host's SSH port, so
# this needs no change to any security group and records the host's address
# nowhere in AWS.
#
# The key on the application host is restricted to forwarding to the database
# endpoint and nothing else: no shell, no pty, no agent forwarding.
Description=SSH tunnel exposing the application database to Grafana
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=root
EnvironmentFile=/opt/pt-observability/secrets/grafana-postgres.env
# Binds on the docker bridge rather than 127.0.0.1, because Grafana runs in a
# container and cannot reach the host's loopback. ExitOnForwardFailure makes a
# refused forward a unit failure instead of a silently dead tunnel that Grafana
# would report as "connection refused" with no clue why.
ExecStart=/usr/bin/ssh -N \
  -i /root/.ssh/pg_tunnel \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -L 172.17.0.1:5432:${DB_HOST}:5432 \
  ec2-user@${APP_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
