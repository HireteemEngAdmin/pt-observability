{$GRAFANA_DOMAIN} {
    # Push de logs do Alloy. Precisa vir antes do handle generico: sem isto o
    # Grafana captura a rota e responde 302 para /login em vez de 401.
    handle /loki/* {
        basic_auth {
            {$LOKI_PUSH_USER} {$LOKI_PUSH_BCRYPT}
        }
        reverse_proxy loki:3100
    }

    handle {
        reverse_proxy grafana:3000
    }
}
