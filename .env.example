# Copy to .env and fill in. .env NEVER goes into git.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DOMAIN=grafana.example.com

# The log push credential does NOT live here: a bcrypt hash contains $ in the
# middle and Compose would interpolate it as a variable, silently mutilating the
# value. It goes in secrets/caddy.env, loaded through env_file. See the README.

# Future phase (alerting through Microsoft Teams, pending approval):
# TEAMS_WEBHOOK_URL=https://prod-XX.brazilsouth.logic.azure.com/workflows/...
