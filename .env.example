# Copie para .env e preencha. O .env NUNCA vai para o git.
GRAFANA_ADMIN_PASSWORD=troque-me
GRAFANA_DOMAIN=grafana.exemplo.com

# Credencial do push de logs do Alloy (gerar conforme o README). O valor aqui e
# o hash bcrypt; a senha em claro fica em secrets/loki_push_password.
LOKI_PUSH_USER=alloy
LOKI_PUSH_BCRYPT=$2a$14$SUBSTITUA_PELO_HASH_GERADO

# Fase futura (alertas via Microsoft Teams, apos aprovacao):
# TEAMS_WEBHOOK_URL=https://prod-XX.brazilsouth.logic.azure.com/workflows/...
