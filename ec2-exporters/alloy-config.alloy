// PM2 logs -> Loki. Runs on the application EC2, outbound connections only.
//
// Two rules shape these globs:
//
// 1. `server` runs in PM2 cluster mode with two instances
//    (ecosystem.config.js), and in that mode PM2 suffixes the instance id:
//    server-out-8.log, server-out-9.log. Pointing at server-out.log reads a
//    file that has been dead since the cluster change — that was the first
//    attempt, and none of the API's logs arrived. The ids come from PM2's
//    internal counter and change when processes are recreated, so the wildcard
//    is required; do not hardcode 8 and 9.
//
// 2. __path_exclude__ keeps the rotated copies out: pm2-logrotate produces
//    server-out-8__2026-07-28_00-00-00.log on every rotation, and without the
//    exclusion Alloy treats each one as a new file and re-ingests it whole.
//
// postgres-mcp-*.log is left out because it is not part of the application.

local.file_match "pm2" {
  path_targets = [
    { __path__ = "/home/ec2-user/.pm2/logs/server-out*.log",   __path_exclude__ = "/home/ec2-user/.pm2/logs/*__*.log", job = "server", stream = "out", host = constants.hostname },
    { __path__ = "/home/ec2-user/.pm2/logs/server-error*.log", __path_exclude__ = "/home/ec2-user/.pm2/logs/*__*.log", job = "server", stream = "err", host = constants.hostname },
    { __path__ = "/home/ec2-user/.pm2/logs/cron-out*.log",     __path_exclude__ = "/home/ec2-user/.pm2/logs/*__*.log", job = "cron",   stream = "out", host = constants.hostname },
    { __path__ = "/home/ec2-user/.pm2/logs/cron-error*.log",   __path_exclude__ = "/home/ec2-user/.pm2/logs/*__*.log", job = "cron",   stream = "err", host = constants.hostname },
  ]
}

loki.source.file "pm2" {
  targets    = local.file_match.pm2.targets
  forward_to = [loki.process.pm2.receiver]
}

loki.process "pm2" {
  // Fold multi-line object dumps back into the preceding entry.
  //
  // firstline matches "a line that does NOT start with a space, a tab or }":
  //   [hubspot] POST ... responded 429   -> new entry
  //   {"level":50,"msg":"..."}           -> new entry (pino, always one line)
  //     stripeCustomerId: 'cus_...',     -> continuation (indented)
  //   }                                  -> continuation (closes the object)
  //
  // The tab matters: Node indents object dumps with spaces, but a hand-written
  // console.log can use tabs, and a negated class that omits \t would treat
  // those as new entries and split the dump apart.
  //
  // Written as a negated class so the regex needs no escaped quotes.
  stage.multiline {
    firstline     = "^[^ \t}]"
    max_wait_time = "3s"
    max_lines     = 200
  }

  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "https://teem.wagnerjunior.dev/loki/api/v1/push"
    basic_auth {
      username = sys.env("LOKI_PUSH_USER")
      password = sys.env("LOKI_PUSH_PASSWORD")
    }
  }
}
