# Template for /etc/node_exporter/web-config.yml on the application EC2.
#
# Why it exists: port 9100 is open to 0.0.0.0/0 in the security group, and an
# unprotected node_exporter hands out the exact kernel version, the private IP,
# the disk layout and the network interfaces to anyone who scans the port. TLS
# plus basic auth keeps the port open and the content unreadable — anyone
# without the credential gets a 401.
#
# This file is NOT copied automatically: the hash below is a placeholder.
# To generate the real one, see the README section "node_exporter on the EC2":
#
#   openssl rand -base64 30 | tr -d '\n' > secrets/node_exporter_password
#   python3 -c "import bcrypt;print(bcrypt.hashpw(open('secrets/node_exporter_password','rb').read(),bcrypt.gensalt(rounds=12)).decode())"
#
# The plaintext password stays in secrets/ (gitignored) and Prometheus reads it
# through password_file; only the bcrypt hash reaches the EC2.

tls_server_config:
  cert_file: /etc/node_exporter/node_exporter.crt
  key_file: /etc/node_exporter/node_exporter.key

basic_auth_users:
  prometheus: $2b$12$REPLACE_WITH_THE_GENERATED_BCRYPT_HASH
