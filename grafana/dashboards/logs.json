{
  "uid": "pt-logs",
  "title": "Performance Tracker Logs",
  "description": "Warning and error logs from the application EC2, shipped by Grafana Alloy. Retention is 30 days and these lines carry PII.",
  "tags": [
    "performance-tracker",
    "observability",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Errors and warnings over time",
      "description": "Read from the level field, not from which stream the line arrived on. This is the panel that answers \"did something start failing at 3am\", which the log list alone cannot show.",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({job=~\"$job\"} |= \"$search\" | json | __error__=\"\" | level=~\"error|warn\" [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Unstructured lines",
      "description": "Lines that did not come from the logger. This is the migration tracker: the backend is at zero console.* calls, so this should stay flat at whatever Node itself emits. Two known sources are legitimate, both at boot: Node's own warnings, and the console output inside migrations/, which run in the deployed process and are deliberately outside the console ban. A sustained rise here during normal traffic means something went back to writing raw.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (stream) (count_over_time({job=~\"$job\"} != `\"service\":\"performance-tracker\"` [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Top failing modules",
      "id": 4,
      "description": "Errors grouped by the logger's module field over the dashboard's time range. Not exception fingerprinting, but it answers what is failing most, which is what you usually open a log dashboard to find out. A line with no module means the logger was used without a binding.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "label_replace(topk(10, sum by (module) (count_over_time({job=~\"$job\"} |= \"$search\" | json | __error__=\"\" | level=\"error\" [$__range]))), \"module\", \"(no module)\", \"module\", \"^$\")",
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 5,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Log stream",
      "id": 6,
      "description": "Filtered by the variables above. Use the search box for free text; it is a substring match, not a regex.",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=~\"$job\", stream=~\"$stream\"} |= \"$search\" | json | level=~\"$level\" or __error__=\"JSONParserErr\"",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "job",
          "type": "1"
        },
        "regex": "^(server|cron)$",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "custom",
        "query": "err,out",
        "options": [
          {
            "text": "err",
            "value": "err",
            "selected": false
          },
          {
            "text": "out",
            "value": "out",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "options": [
          {
            "text": "error",
            "value": "error",
            "selected": true
          },
          {
            "text": "warn",
            "value": "warn",
            "selected": true
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "error",
            "warn"
          ],
          "value": [
            "error",
            "warn"
          ]
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
