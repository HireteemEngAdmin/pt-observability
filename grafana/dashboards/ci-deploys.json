          "expr": "app_build_info",
          "legendFormat": "{{service}} {{version}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "showValue": "auto",
        "alignValue": "left",
        "mergeValues": true,
