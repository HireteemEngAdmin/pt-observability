{
  "uid": "pt-api",
  "title": "Performance Tracker API",
  "description": "Metricas de aplicacao do Performance Tracker (jobs api e cron). Host da EC2 fica no dashboard Node Exporter Full.",
  "tags": [
    "performance-tracker",
    "observability"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
