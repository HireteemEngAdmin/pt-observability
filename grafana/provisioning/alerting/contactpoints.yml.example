# FUTURE PHASE (alerting, pending manager approval). To enable:
# 1. Create the Teams channel webhook through Workflows/Power Automate
#    (Microsoft retired the classic O365 connectors).
# 2. Add TEAMS_WEBHOOK_URL to .env and to the grafana environment in
#    docker-compose.yml.
# 3. Rename this file to contactpoints.yml (and policies.yml.example to
#    policies.yml), then run: docker compose up -d
apiVersion: 1
contactPoints:
  - orgId: 1
    name: teams-pt-alerts
    receivers:
      - uid: teams-pt-alerts
        type: teams
        settings:
          url: $TEAMS_WEBHOOK_URL
